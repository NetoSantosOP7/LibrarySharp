@{
    ViewData["Title"] = "Cadastrar Livro";
}

<h1>Cadastrar novo livro</h1>

<form action="/Livro/Criar" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label>Título</label>
        <input type="text" name="Titulo" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Autor</label>
        <input type="text" name="Autor" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Ano de Publicação</label>
        <input type="number" name="AnoPublicacao" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Disponível</label>
        <input type="checkbox" name="Disponivel" value="true" />
    </div>
    <div class="mb-3">
        <label>Capa do livro</label>
        <input type="file" name="Imagem" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>