@model Dictionary<string, object>
@{
    ViewData["Title"] = "Editar Livro";
}

<h1>Editar livro</h1>

<form action="/Livro/Atualizar" method="post" enctype="multipart/form-data">

    <input type="hidden" name="Id" value="@Model["Id"]" />
    <input type="hidden" name="CaminhoImagemAtual" value="@Model["CaminhoImagem"]" />

    <div class="mb-3">
        <label>Título</label>
        <input type="text" name="Titulo" class="form-control" value="@Model["Titulo"]" required />
    </div>
    <div class="mb-3">
        <label>Autor</label>
        <input type="text" name="Autor" class="form-control" value="@Model["Autor"]" required />
    </div>
    <div class="mb-3">
        <label>Ano de Publicação</label>
        <input type="number" name="AnoPublicacao" class="form-control" value="@Model["AnoPublicacao"]" required />
    </div>
    <div class="mb-3">
        <label>Disponível</label>
        <input type="checkbox" name="Disponivel" checked="@((bool)Model["Disponivel"])" />
    </div>
    <div class="mb-3">
        <label>Capa do livro</label>
        <input type="file" name="Imagem" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>